# Codex configuration for this project (local runs).
# Copy into your Codex config file:  Windows: %USERPROFILE%\.codex\config.toml   macOS/Linux: ~/.codex/config.toml
# Check key names against the Codex configuration reference if your Codex version rejects one.

model = "gpt-6-astra"            # or the Astra / GPT-6 model your plan offers
model_reasoning_effort = "high"  # "xhigh" if your plan and model offer it

# Edit files inside the project folder; requests that need more are reviewed automatically instead of asking you.
sandbox_mode = "workspace-write"
approval_policy = "on-request"
approvals_reviewer = "auto_review"   # "Approve for me". Use approval_policy = "never" to refuse such requests instead.

# The pipeline downloads NASA data and npm/pip packages, and git pushes to GitHub: commands need network access.
[sandbox_workspace_write]
network_access = true
