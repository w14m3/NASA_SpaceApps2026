{
  "name": "sightline-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "oxlint src e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=../reports/vitest.json",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.93.0",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
